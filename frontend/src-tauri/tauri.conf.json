{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Interactive Tutor",
  "version": "0.5.0",
  "identifier": "com.interactivetutor.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Interactive Tutor",
        "create": false,
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "binaries/tutor-backend/": "tutor-backend/",
      "binaries/tesseract/": "tesseract/"
    },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
